# Secrets. Keys live only in .env, which is never committed.
.env
.env.*
!.env.example
*.pem
*.key
keys/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
.vite/

# Foundry build output and local Anvil broadcasts
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/

# Browser check output
out/

# Local only
.claude/settings.local.json
*.log
.DS_Store
Thumbs.db

# Agent wallet state and local evidence from Anvil runs
backend/var/
evidence/anvil/

# Red-team cache and run output; only the published runs are kept, with the first full run that a fix replaced
redteam/cache/
redteam/results/*
!redteam/results/final/
!redteam/results/final-1/
!redteam/results/domestic-kimi/
!redteam/results/zh-kimi/
!redteam/results/variants-stage1/

# Local evidence from scripts/run_demo.py --network anvil
evidence/anvil-demo/

# Service logs of the Base Sepolia trustee session: an RPC error can print the provider URL
evidence/sepolia-trustee/*.log
