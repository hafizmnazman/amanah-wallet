# Every variable the build uses, from IMPLEMENTATION_PLAN.md section 9.
# Copy to .env and fill in. Never commit .env.

# Chain
CHAIN_ID=84532
# Alchemy or Infura Base Sepolia endpoint; the public RPC is rate-limited
RPC_URL=
VAULT_ADDRESS=
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
EXPLORER_URL=https://sepolia.basescan.org
# Funded key that submits execute(); holds no role
RELAYER_KEY=

# Signer keys, each only in its own service's environment
PLANNER_KEY=
AUDITOR_KEY=
SENTINEL_KEY=
POSTURE_ORACLE_KEY=
# Trustee keys for development and the scripted demo only; real trustees sign in MetaMask
TRUSTEE1_KEY=
TRUSTEE2_KEY=
TRUSTEE3_KEY=
GUARDIAN_KEY=
# Same-lineage control auditor (Claude) for scenario 11 and the red-team S2 arm
CONTROL_AUDITOR_KEY=

# Deployment (contracts/script/Deploy.s.sol). Trustee and guardian addresses override the keys above,
# so a trustee whose key lives only in MetaMask can still be named.
TRUSTEE1=
TRUSTEE2=
TRUSTEE3=
GUARDIAN=
# Seconds; 600 for the demo deployment, 172800 (48 hours) in production
COOLING_OFF=600

# Models (model names are set here from each provider's catalogue; the code never hardcodes one)
# anthropic or bedrock
PLANNER_PROVIDER=anthropic
ANTHROPIC_API_KEY=
PLANNER_MODEL=
AWS_REGION=
DASHSCOPE_API_KEY=
# Model Studio OpenAI-compatible endpoint, international edition
DASHSCOPE_BASE_URL=
AUDITOR_MODEL=
OPENAI_API_KEY=
REDTEAM_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
REDTEAM_FALLBACK_MODEL=
DAILY_MODEL_CALL_CAP=

# Services
AUDITOR_URL=http://127.0.0.1:8101
SENTINEL_URL=http://127.0.0.1:8102
# Keyed hashes for beneficiary ids
INSTITUTION_HMAC_KEY=
# Contract verification only
BASESCAN_API_KEY=

# Agent wallet backend (lane B), all optional. docs/api.md and docs/decisions.md B-1 to B-11 explain them.
# Per-role models; each falls back to PLANNER_MODEL. The auditor's fallback stays on the Qwen endpoint.
READER_MODEL=
REPORTER_MODEL=
AUDITOR_CONTROL_MODEL=
AUDITOR_FALLBACK_MODEL=
# Claude effort per role (PLANNER_EFFORT, READER_EFFORT, ...); the default is high
PLANNER_EFFORT=
# Server-side refusal fallbacks for Claude: on unless this is off. Red-team runs set it to off.
PLANNER_REFUSAL_FALLBACK=
# USD per million input and output tokens as "in,out", from each provider's price list; unset records no cost
PLANNER_PRICE_PER_MTOK=
AUDITOR_PRICE_PER_MTOK=
AUDITOR_CONTROL_PRICE_PER_MTOK=
REDTEAM_PRICE_PER_MTOK=
# 1 answers every model call from deterministic offline rules, even with keys present
AGENTWALLET_DRY_RUN=
# http (default) calls the checker services; inprocess runs them inside the API process
AGENTWALLET_CHECKERS=
CHECKER_TIMEOUT=60
# 0 stops a checker anchoring its own refusals on-chain
AUDITOR_ANCHOR=
SENTINEL_ANCHOR=
# Fail-closed queue retries; AGENTWALLET_QUEUE_RETRY=0 turns the background loop off
QUEUE_RETRY_SECONDS=60
AGENTWALLET_QUEUE_RETRY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Paths; the defaults are redteam/data/books.json, evidence/ and backend/var/
BOOKS_PATH=
EVIDENCE_DIR=
AGENTWALLET_STATE_DIR=
# An ISO date that date checks run against, for repeatable runs; unset means today
AGENTWALLET_TODAY=
# Recurring payouts (plan task B11): drafts for this officer every SCHEDULE_SECONDS; AGENTWALLET_SCHEDULE=0 turns it off
SCHEDULE_OFFICER=officer-1
SCHEDULE_SECONDS=3600
AGENTWALLET_SCHEDULE=
# Lower these only for the immune loop's demo cycle; redteam/protocol.md fixes 0.10 and 0.25
POSTURE_THRESHOLD_1=
POSTURE_THRESHOLD_2=
# Frontend variables: see frontend/.env.example
