# Every variable the build uses, from IMPLEMENTATION_PLAN.md section 9.
# Copy to .env and fill in. Never commit .env.

# Chain
CHAIN_ID=84532
# Alchemy or Infura Base Sepolia endpoint; the public RPC is rate-limited
RPC_URL=
VAULT_ADDRESS=
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
EXPLORER_URL=https://sepolia.basescan.org
# Funded key that submits execute(); holds no role
RELAYER_KEY=

# Signer keys, each only in its own service's environment
PLANNER_KEY=
AUDITOR_KEY=
SENTINEL_KEY=
POSTURE_ORACLE_KEY=
# Trustee keys for development and the scripted demo only; real trustees sign in MetaMask
TRUSTEE1_KEY=
TRUSTEE2_KEY=
TRUSTEE3_KEY=
GUARDIAN_KEY=

# Models (model names are set here from each provider's catalogue; the code never hardcodes one)
# anthropic or bedrock
PLANNER_PROVIDER=anthropic
ANTHROPIC_API_KEY=
PLANNER_MODEL=
AWS_REGION=
DASHSCOPE_API_KEY=
# Model Studio OpenAI-compatible endpoint, international edition
DASHSCOPE_BASE_URL=
AUDITOR_MODEL=
OPENAI_API_KEY=
REDTEAM_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
REDTEAM_FALLBACK_MODEL=
DAILY_MODEL_CALL_CAP=

# Services
AUDITOR_URL=http://127.0.0.1:8101
SENTINEL_URL=http://127.0.0.1:8102
# Keyed hashes for beneficiary ids
INSTITUTION_HMAC_KEY=
# Contract verification only
BASESCAN_API_KEY=
