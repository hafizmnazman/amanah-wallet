# Copy to .env.local and fill in. Never commit .env.local.

# Backend from lane B. The backend allows CORS from http://localhost:5173 and http://127.0.0.1:5173.
VITE_API_URL=http://127.0.0.1:8000
# 1 plays the scripted demo in the browser with no backend. Everything it shows carries a "Mock data" badge.
VITE_MOCK_API=0
# Milliseconds of simulated latency in mock mode
VITE_MOCK_LATENCY_MS=200

# Chain the trustee signs for: 84532 Base Sepolia, 31337 Anvil
VITE_CHAIN_ID=84532
# The deployed AmanahVault; the trustee page warns when a payout's domain names another contract
VITE_VAULT_ADDRESS=
# Optional RPC for wallet reads; the public endpoint is used when empty
VITE_RPC_URL=
VITE_EXPLORER_URL=https://base-sepolia.blockscout.com

# Development only: a "Sign with local trustee key" button, for the demo video if MetaMask misbehaves.
# Put the key in .env.local, never here.
VITE_DEV_SIGNING=0
VITE_DEV_TRUSTEE_KEY=
